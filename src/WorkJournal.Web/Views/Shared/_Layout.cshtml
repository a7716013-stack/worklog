<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · WorkJournal</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
<a class="visually-hidden-focusable skip-link" href="#main-content">跳至主要內容</a>
<header class="dashboard-header"><nav class="navbar navbar-expand-xl page-width" aria-label="主要導覽">
<a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span class="brand-icon" aria-hidden="true">W</span><span>WorkJournal<small>WORK & INVEST</small></span></a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="切換導覽選單"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="main-navigation"><partial name="_DashboardNavigation" /></div>
</nav></header>
<main class="page-width main-content" id="main-content">
@if (TempData["Success"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@RenderBody()
@if (TempData["Warning"] is string warning) { <div class="alert alert-warning" role="status">@warning</div> }
</main>
<footer class="page-width footer"><span>WORK JOURNAL v@(typeof(WorkJournal.Web.Models.ApplicationUser).Assembly.GetName().Version?.ToString(3))</span><span>記錄每一天的進步，累積更好的決策。</span></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
