@model PaperTradingViewModel
@{
    ViewData["Title"] = "我的虛擬投資組合";
    var portfolio = Model.Portfolio;
    var account = portfolio.Account;
    var stats = WorkJournal.Web.Services.PortfolioAnalyticsCalculator.Calculate(portfolio.Trades);
    string Money(decimal? value) => value?.ToString("N2") ?? "—";
    string Tone(decimal? value) => value > 0 ? "paper-profit" : value < 0 ? "paper-loss" : "";
    string Time(DateTimeOffset? value) => value?.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm:ss") ?? "—";
    string Side(PaperOrderSide side) => side == PaperOrderSide.Buy ? "買進" : "賣出";
    string Status(PaperOrderStatus status) => status switch {
        PaperOrderStatus.Pending => "等待中 Pending", PaperOrderStatus.Filled => "已成交 Filled",
        PaperOrderStatus.Cancelled => "已取消 Cancelled", _ => "已拒絕 Rejected"
    };
}
<partial name="_Navigation" />
<section class="page-heading">
    <div><p class="eyebrow">MY VIRTUAL PORTFOLIO · v1.5.2</p><h1>我的虛擬投資組合</h1><p class="subheading">模擬交易，不會送出真實證券委託</p></div>
    <form asp-action="RefreshPaperOrders" method="post"><button class="btn btn-forest" type="submit">檢查待成交委託</button></form>
</section>
<div class="alert alert-info" id="paper-live-status" data-url="@Url.Action("PaperQuotes")">
    開盤期間每 15 秒查詢證交所 MIS 最近成交報價，更新持股市值與損益；每檔顯示報價時間。休市或盤中資料不可用時顯示日行情參考。虛擬委託仍依已完成日行情模擬成交。資金、委託、成交與持倉儲存在你的登入帳號，換裝置登入同一帳號即可查看。
</div>
@if (portfolio.HasIncompleteValuation)
{
    <div class="alert alert-warning" role="status">部分行情暫時無法取得；部分持股缺少最新行情，總資產估值不完整。</div>
}
<link rel="stylesheet" href="~/css/investment-insights.css" asp-append-version="true" />
<div class="strategy-portfolio-layout"><div><div id="portfolio-app" data-history-url="@Url.Action("PortfolioHistory")" data-default-tab="@(ViewData.ModelState.IsValid&&string.IsNullOrEmpty(Model.Order.StockId)?"positions":"orders")">
<section class="panel portfolio-hero"><div class="insight-heading"><div><p class="eyebrow">TOTAL ASSETS · TWD</p><h2>總資產</h2><strong id="portfolio-total" data-live="totalAssets" data-prefix="$">$@Money(portfolio.TotalAssets)</strong><p>累積報酬 <b data-live="totalReturnPercent" data-suffix="%" class="@Tone(portfolio.TotalReturnPercent)">@Money(portfolio.TotalReturnPercent)%</b></p></div><button class="btn btn-forest" type="button" data-portfolio-open="orders">＋建立虛擬單</button></div>
<div class="portfolio-metrics insight-grid">
<div><span>最大回撤</span><strong id="portfolio-drawdown">載入中…</strong><small>每日資產觀測期間</small></div>
<div><span>勝率</span><strong>@Money(stats.WinRate)%</strong><small>@stats.Completed 筆已結束交易</small></div>
<div><span>Profit Factor</span><strong>@(stats.ProfitFactor.HasValue?Money(stats.ProfitFactor):stats.Wins>0?"無虧損交易":"—")</strong><small>總獲利／總虧損絕對值</small></div>
<div><span>平均獲利</span><strong>@Money(stats.AverageWin)%</strong></div><div><span>平均虧損</span><strong>@Money(stats.AverageLoss)%</strong></div><div><span>盈虧比</span><strong>@Money(stats.PayoffRatio)</strong></div>
</div><p>交易統計涵蓋本次帳戶重設後的全部成交，以同一標的建倉至全部出清算一筆；平手計入勝率分母，未出清部位不計入。費用依實際模擬成交紀錄計算。</p>
</section>
<section class="panel portfolio-curve"><div class="insight-heading"><div><p class="eyebrow">PORTFOLIO VALUE</p><h2>總資產走勢</h2></div><label>顯示區間 <select id="portfolio-range" class="form-select"><option value="1">1 個月</option><option value="3">3 個月</option><option value="6">6 個月</option><option value="12">1 年</option><option value="all" selected>全部</option></select></label></div>
<div id="portfolio-chart" role="status">正在讀取資產紀錄…</div><p id="portfolio-point" aria-live="polite"></p><p id="portfolio-period" class="muted"></p><p>每日總資產＝現金＋持倉收盤市值，含未實現損益。13:40 後依當日完整官方行情保存；主機運行時每 15 分鐘更新。缺價或休市不記錄，不回填未觀測日期。幣別 TWD。</p></section>
<div class="portfolio-tabs" role="tablist" aria-label="投資組合分頁">
@foreach(var t in new[]{("cash","Cash 資金"),("positions","Position 持倉"),("orders","Order 委託"),("trades","Trade 成交"),("pnl","P/L 損益")}){<button type="button" role="tab" id="portfolio-tab-@t.Item1" aria-controls="portfolio-panel-@t.Item1" data-portfolio-tab="@t.Item1" aria-selected="false">@t.Item2</button>}
</div>
<section id="portfolio-panel-cash" role="tabpanel" aria-labelledby="portfolio-tab-cash" class="portfolio-tab-panel"><div class="stats-grid paper-stats" aria-label="虛擬帳戶摘要">
    <div class="stat"><span>初始資金</span><strong id="paper-initial">@Money(account.InitialCash)</strong><p>新台幣元</p></div>
    <div class="stat"><span>可用現金</span><strong id="paper-cash">@Money(account.Cash)</strong><p>限價等待單不預扣資金</p></div>
    <div class="stat"><span>持股市值</span><strong data-live="totalMarketValue">@Money(portfolio.TotalMarketValue)</strong><p>@(portfolio.HasIncompleteValuation ? "僅包含可估值持股" : "依各股票下方標示的行情時間")</p></div>
    <div class="stat"><span>總資產</span><strong data-live="totalAssets">@Money(portfolio.TotalAssets)</strong><p>現金＋持股市值</p></div>
    <div class="stat"><span>已實現損益</span><strong class="@Tone(account.RealizedProfitLoss)">@Money(account.RealizedProfitLoss)</strong><p>含買賣手續費與模擬稅費</p></div>
    <div class="stat"><span>未實現損益</span><strong data-live="unrealizedProfitLoss" class="@Tone(portfolio.UnrealizedProfitLoss)">@Money(portfolio.UnrealizedProfitLoss)</strong><p>未扣未來賣出費用</p></div>
    <div class="stat"><span>總損益</span><strong data-live="totalProfitLoss" class="@Tone(portfolio.TotalProfitLoss)">@Money(portfolio.TotalProfitLoss)</strong><p>總資產－初始資金</p></div>
    <div class="stat"><span>總報酬率</span><strong data-suffix="%" data-live="totalReturnPercent" class="@Tone(portfolio.TotalReturnPercent)">@(portfolio.TotalReturnPercent?.ToString("N2") ?? "—")%</strong><p>相對初始資金</p></div>
</div>
<p>等待委託不預扣現金或保留持股；委託占用資金為 0，可下單現金等於現金餘額。成交仍須通過既有資源驗證。</p></section>
<section id="portfolio-panel-positions" role="tabpanel" aria-labelledby="portfolio-tab-positions" class="portfolio-tab-panel"><section class="panel paper-section mt-4" aria-labelledby="paper-positions-title">
    <h2 id="paper-positions-title">持有部位</h2>
    <p class="muted">持股與委託標的可加入個人績效模型驗證，使用最新可用行情的雷達 V1 快照；不改動委託，也不回填下單時的評分。</p>
    @if (portfolio.Positions.Count == 0) { <p class="muted" id="paper-empty">尚無持股，建立第一筆虛擬買進委託開始模擬。</p> }
    else {
    <div class="table-responsive"><table class="table text-nowrap" id="paper-positions"><thead><tr><th>股票／名稱</th><th>股數</th><th>平均成本</th><th>最新價格／行情日</th><th>市值</th><th>未實現損益</th><th>報酬率</th><th>操作</th></tr></thead><tbody>
    @foreach (var item in portfolio.Positions) {
        var p = item.Position;
        <tr data-symbol="@p.StockId"><td><a asp-action="Index" asp-route-symbol="@p.StockId">@p.StockId @p.StockName</a></td><td class="paper-quantity">@p.Quantity.ToString("N0")</td><td>@p.AverageCost.ToString("N6")</td><td><span data-tick="currentPrice">@Money(item.CurrentPrice)</span><small class="d-block muted" data-tick-status>@item.QuoteStatus · @(item.QuoteTime.HasValue ? Time(item.QuoteTime) : item.Quote?.TradeDate?.ToString("yyyy/MM/dd") ?? "—")</small></td><td data-tick="marketValue">@Money(item.MarketValue)</td><td data-tick="unrealizedProfitLoss" class="@Tone(item.UnrealizedProfitLoss)">@Money(item.UnrealizedProfitLoss)</td><td data-tick="returnPercent" class="@Tone(item.ReturnPercent)">@Money(item.ReturnPercent)%</td>
        <td><a asp-action="PaperTrading" asp-route-symbol="@p.StockId" asp-route-side="Buy" asp-fragment="paper-order-section" class="btn btn-light btn-sm">買進</a> <a asp-action="PaperTrading" asp-route-symbol="@p.StockId" asp-route-side="Sell" asp-fragment="paper-order-section" class="btn btn-light btn-sm">賣出</a> <partial name="_PerformanceValidationButton" model="p.StockId" /> <partial name="_AddToSwingButton" model="p.StockId" /> <partial name="_FavoriteButton" model="p.StockId" /></td></tr>
    }
    </tbody></table></div>
    }
</section>
</section>
<section id="portfolio-panel-orders" role="tabpanel" aria-labelledby="portfolio-tab-orders" class="portfolio-tab-panel"><section class="panel paper-section" id="paper-order-section" aria-labelledby="paper-order-title">
    <h2 id="paper-order-title">建立虛擬委託</h2>
    <form asp-action="PlacePaperOrder" method="post" id="paper-order-form">
        <input asp-for="RecommendationId" type="hidden" />
        <input asp-for="Order.StrategySignalId" type="hidden" />
        @if (Model.Order.StrategySignalId.HasValue) { <p class="alert alert-info">來源：<a asp-action="StrategySignal" asp-route-id="@Model.Order.StrategySignalId">策略訊號 #@Model.Order.StrategySignalId</a>。請確認目前行情與委託內容；快照價格不作為成交價。</p> }
        @if (Model.Recommendation is {} recommendation) {
            <p class="alert alert-info">推薦來源：@recommendation.TradeDate · @recommendation.StockId @recommendation.StockName · 分數 @(recommendation.Score?.ToString() ?? "不完整")。請自行確認委託內容後送出。</p>
        }
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="Order.ClientRequestId" type="hidden" /><input asp-for="Order.AccountGeneration" type="hidden" />
        <div class="paper-form-grid">
            <div><label asp-for="Order.StockId" class="form-label"></label><input asp-for="Order.StockId" class="form-control" maxlength="6" placeholder="2330、0050" required /><span asp-validation-for="Order.StockId" class="text-danger"></span></div>
            <div><label asp-for="Order.Side" class="form-label"></label><select asp-for="Order.Side" class="form-select"><option value="Buy">買進</option><option value="Sell">賣出</option></select></div>
            <div><label asp-for="Order.OrderType" class="form-label"></label><select asp-for="Order.OrderType" class="form-select"><option value="Market">市價（最新收盤價）</option><option value="Limit">限價（後續交易日）</option></select></div>
            <div><label asp-for="Order.Quantity" class="form-label"></label><input asp-for="Order.Quantity" class="form-control" type="number" min="1" max="100000000" step="1" required /><span asp-validation-for="Order.Quantity" class="text-danger"></span></div>
            <div><label asp-for="Order.LimitPrice" class="form-label"></label><input asp-for="Order.LimitPrice" class="form-control" type="number" min="0.0001" max="1000000" step="0.0001" /><span asp-validation-for="Order.LimitPrice" class="text-danger"></span></div>
        </div>
        <p class="muted mt-3">1000 股＝1 張。市價單「以最新收盤價模擬成交」，成交價由伺服器行情決定。</p>
        <button type="submit" class="btn btn-forest">送出虛擬委託</button>
    </form>
    <details class="mt-3"><summary>成交與費用規則</summary>
        <p class="muted mt-2">限價買進須新日行情最低價 ≤ 限價；限價賣出須最高價 ≥ 限價，均以委託限價模擬成交。只接受建立日之後且晚於建立時行情日期的日 K。這只是 OHLC 日資料模擬，無法知道盤中實際成交順序。</p>
        <p class="muted">按「檢查待成交委託」才檢查最新可用日行情，不回補離線期間各日成交；行情快取 5 分鐘。等待單不保留現金或股票，成交時再次檢查，不足即拒絕；不支援放空。</p>
        <p class="muted">模擬手續費：成交金額 × @((Model.Costs.CommissionRate * 100).ToString("0.####"))% × @Model.Costs.CommissionDiscount.ToString("0.####")，最低 @Money(Model.Costs.MinimumCommission) 元；賣出模擬稅費：股票 @((Model.Costs.StockSellTaxRate * 100).ToString("0.####"))%、ETF @((Model.Costs.EtfSellTaxRate * 100).ToString("0.####"))%。金額四捨五入至小數兩位。這些是模擬參數，不代表最新法規或實際券商費率。</p>
        <p class="muted">平均成本包含買進手續費。未處理股利、分割、減資、滑價、成交量與漲跌停限制；歷史或模擬結果不代表未來績效。所有時間顯示為台灣時間。</p>
    </details>
</section>
<section class="panel paper-section mt-4" aria-labelledby="paper-orders-title">
    <h2 id="paper-orders-title">委託紀錄</h2>
    @if (portfolio.Orders.Count == 0) { <p class="muted">尚無虛擬委託。</p> }
    else {
    <div class="table-responsive"><table class="table text-nowrap" id="paper-orders"><thead><tr><th>建立時間</th><th>股票</th><th>方向／類型</th><th>股數</th><th>限價</th><th>狀態</th><th>成交價</th><th>成交時間／行情日</th><th>限價可評估起日</th><th>原因／操作</th></tr></thead><tbody>
    @foreach (var order in portfolio.Orders) {
        <tr data-order-id="@order.Id" data-status="@order.Status"><td>@Time(order.CreatedAt)</td><td>@order.StockId @order.StockName</td><td>@Side(order.Side) / @(order.OrderType == PaperOrderType.Market ? "市價" : "限價")</td><td>@order.Quantity.ToString("N0")</td><td>@Money(order.LimitPrice)</td><td>@Status(order.Status)</td><td>@Money(order.FilledPrice)</td><td>@Time(order.FilledAt)<small class="d-block muted">@(order.FilledTradeDate?.ToString("yyyy/MM/dd") ?? "—")</small></td><td>@(order.OrderType == PaperOrderType.Limit ? order.EligibleFromTradeDate?.ToString("yyyy/MM/dd") ?? "—" : "—")</td><td>@order.RejectReason
        @if (order.Status == PaperOrderStatus.Pending) { <form asp-action="CancelPaperOrder" method="post"><input type="hidden" name="id" value="@order.Id" /><button type="submit" class="btn btn-light btn-sm">取消</button></form> }
        <partial name="_PerformanceValidationButton" model="order.StockId" /> <partial name="_AddToSwingButton" model="order.StockId" /> <partial name="_FavoriteButton" model="order.StockId" />
        </td></tr>
    }
    </tbody></table></div>
    }
</section>
</section>
<section id="portfolio-panel-trades" role="tabpanel" aria-labelledby="portfolio-tab-trades" class="portfolio-tab-panel"><section class="panel paper-section mt-4" aria-labelledby="paper-trades-title">
    <h2 id="paper-trades-title">成交紀錄</h2>
    @if (portfolio.Trades.Count == 0) { <p class="muted">尚無模擬成交。</p> }
    else {
    <div class="table-responsive"><table class="table text-nowrap" id="paper-trades"><thead><tr><th>成交時間／行情日</th><th>股票</th><th>方向</th><th>股數</th><th>成交價</th><th>成交金額</th><th>手續費</th><th>交易稅</th><th>現金流</th><th>已實現損益</th></tr></thead><tbody>
    @foreach (var trade in portfolio.Trades) {
        <tr data-order-id="@trade.OrderId"><td>@Time(trade.ExecutedAt)<small class="d-block muted">@trade.QuoteTradeDate.ToString("yyyy/MM/dd")</small></td><td>@trade.StockId @trade.StockName</td><td>@Side(trade.Side)</td><td>@trade.Quantity.ToString("N0")</td><td>@Money(trade.Price)</td><td>@Money(trade.GrossAmount)</td><td>@Money(trade.Commission)</td><td>@Money(trade.TransactionTax)</td><td>@Money(trade.NetCashAmount)</td><td class="@Tone(trade.RealizedProfitLoss)">@Money(trade.RealizedProfitLoss)</td></tr>
    }
    </tbody></table></div>
    }
</section>
</section>
<section id="portfolio-panel-pnl" role="tabpanel" aria-labelledby="portfolio-tab-pnl" class="portfolio-tab-panel"><section class="panel paper-section"><h2>損益明細</h2><p>已實現 @Money(account.RealizedProfitLoss) 元 ／ 未實現 <span data-live="unrealizedProfitLoss">@Money(portfolio.UnrealizedProfitLoss)</span> 元 ／ 合計 <span data-live="totalProfitLoss">@Money(portfolio.TotalProfitLoss)</span> 元。</p><p>平均報酬＝完整交易淨現金流／累計買入成本（含手續費）；Profit Factor 使用金額，不以勝率或報酬率比例代替。</p>
<div class="table-responsive"><table class="table"><thead><tr><th>標的</th><th>建倉</th><th>出清</th><th>投入成本</th><th>淨損益</th><th>報酬</th></tr></thead><tbody>
@foreach(var item in stats.Investments){<tr><td><a asp-action="Index" asp-route-symbol="@item.Symbol">@item.Symbol</a></td><td>@Time(item.OpenedAt)</td><td>@Time(item.ClosedAt)</td><td>@Money(item.Invested)</td><td class="@Tone(item.Profit)">@Money(item.Profit)</td><td>@Money(item.ReturnPercent)%</td></tr>}
</tbody></table></div>@if(stats.Completed==0){<p>尚無完整出清的交易，統計等待累積。</p>}</section></section>
</div>
</div><aside class="panel"><h2>自選清單</h2><div id="strategy-favorites" data-url="@Url.Action("FavoriteItems")">載入中…</div><a asp-action="Favorites">管理自選清單</a></aside></div>
<section class="panel mt-4"><h2>績效追蹤</h2><p>個人模型驗證與策略 Episode 分開統計。</p><a asp-action="RadarTracking" class="btn btn-light">我的追蹤</a> <a asp-action="Strategies" asp-route-tab="performance" class="btn btn-light">策略績效</a> <a asp-action="RadarPerformance" class="btn btn-light">模型驗證</a></section>
<section class="panel mt-4"><h2>虛擬單與策略來源對照</h2><p>交易依個人操作與既有費稅計算，模型績效依固定交易日觀察。</p>
@foreach(var order in portfolio.Orders.Where(x=>x.StrategySignalId.HasValue)){<p><a asp-action="Index" asp-route-symbol="@order.StockId">@order.StockId @order.StockName</a> · @Status(order.Status) · <a asp-action="StrategySignal" asp-route-id="@order.StrategySignalId">策略訊號 #@order.StrategySignalId</a></p>}
<a asp-action="RadarPaperComparison" class="btn btn-light">既有 Radar 虛擬單對照</a></section>
<link rel="stylesheet" href="~/css/strategy-center.css" asp-append-version="true" />
<section class="panel paper-section mt-4">
    <details><summary>重設虛擬帳戶</summary>
        <p class="mt-3">清除所有虛擬委託、成交及持倉，現金恢復為初始資金 @Money(account.InitialCash) 元。工作日誌不受影響。</p>
        <form asp-action="ResetPaperAccount" method="post" id="paper-reset-form">
            <input type="hidden" name="generation" value="@account.Generation" />
            <label class="d-block mb-3"><input type="checkbox" name="confirmReset" value="true" required /> 我確認清除我的虛擬帳戶的所有交易資料</label>
            <button class="btn btn-outline-danger" type="submit">確認重設虛擬帳戶</button>
        </form>
    </details>
</section>
@section Scripts { <script src="~/js/strategy-center.js" asp-append-version="true"></script> <script src="~/js/paper-intraday.js" asp-append-version="true"></script><script src="~/js/paper-trading.js" asp-append-version="true"></script><script src="~/js/portfolio-insights.js" asp-append-version="true"></script> }
