@model WorkLog
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "新增日誌" : "編輯日誌";
}
<a class="back-link" asp-action="Index">← 返回日誌總覽</a>
<div class="page-heading compact"><div><p class="eyebrow">MAKE PROGRESS VISIBLE</p><h1>@ViewData["Title"]</h1><p class="subheading">記錄今天的重點，也為下一步留點線索。</p></div></div>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)" method="post" class="panel editor-panel">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row g-4">
        <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" placeholder="例如：完成客戶網站首頁設計" maxlength="120" required /><span asp-validation-for="Title" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="WorkDate" class="form-label"></label><input asp-for="WorkDate" type="date" min="2000-01-01" max="2100-12-31" class="form-control" required /><span asp-validation-for="WorkDate" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" type="time" asp-format="{0:HH:mm}" class="form-control" /><span asp-validation-for="StartTime" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" type="time" asp-format="{0:HH:mm}" class="form-control" /><span asp-validation-for="EndTime" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Color" class="form-label"></label><select asp-for="Color" asp-items="Html.GetEnumSelectList<WorkColor>()" class="form-select"></select><span asp-validation-for="Color" class="text-danger"></span></div>
        <p class="muted mb-0">時間為日誌日期當天的時段，可同時留空；工時可另填實際投入時間。顏色用於月曆分類。</p>
        <div class="col-md-6"><label asp-for="Project" class="form-label"></label><input asp-for="Project" class="form-control" placeholder="選填，例如：官網改版" maxlength="80" /><span asp-validation-for="Project" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="Hours" class="form-label"></label><div class="input-group"><input asp-for="Hours" class="form-control" type="number" step="0.25" min="0" max="24" required /><span class="input-group-text">小時</span></div><span asp-validation-for="Hours" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<WorkStatus>()" class="form-select"></select><span asp-validation-for="Status" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" class="form-control" rows="7" placeholder="今天做了哪些事？有哪些成果、問題或學習？" maxlength="4000" required></textarea><span asp-validation-for="Content" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="NextSteps" class="form-label"></label><textarea asp-for="NextSteps" class="form-control" rows="3" placeholder="選填：接下來要完成什麼，或有哪些事需要追蹤？" maxlength="2000"></textarea><span asp-validation-for="NextSteps" class="text-danger"></span></div>
    </div>
    <div class="form-actions"><a asp-action="Index" class="btn btn-light">取消</a><button type="submit" class="btn btn-forest">@(isNew ? "建立日誌" : "儲存變更")</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/worklog-validation.js" asp-append-version="true"></script> }


