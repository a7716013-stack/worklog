<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>3.0.7</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>workjournal-google-auth</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;App_Data/market-data/**;bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="bin/**;obj/**;App_Data/market-data/**" />
    <None Remove="bin/**;obj/**;App_Data/market-data/**" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <ProjectReference Include="../WorkJournal.MarketData/WorkJournal.MarketData.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

</Project>
